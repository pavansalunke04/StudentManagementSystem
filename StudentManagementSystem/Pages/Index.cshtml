    <!-- ══════════════ ABOUT US ══════════════ -->
    <section id="about">
        <div class="about-img-wrap reveal">
            <span class="section-tag" style="margin-bottom:14px;display:inline-block;"><i class="fas fa-university"></i> About Us</span>
            <div class="about-who-header">
                <h3><i class="fas fa-users"></i> Who We Are?</h3>
            </div>
            <div class="about-who-text">
                <p>We are final year MCA students from <strong>Indira University, Pune</strong> — passionate about building real-world web applications that solve everyday problems in education.</p>
                <p>This <strong>Student Management System (SMS)</strong> was built as our academic project with a vision to digitize the entire student record process — from enrollment to results.</p>
                <p>Our system supports <strong>three roles</strong> — Admin, Teacher, and Student — each with their own dashboard and permissions, making academic management faster, smarter, and paperless.</p>
                <p>We believe technology should empower education. With this platform, institutions can manage <strong>attendance, marks, and student data</strong> in real time — no more spreadsheets, no more paperwork.</p>
                <p>Built with <strong>HTML, CSS, JavaScript, ASP.NET Web API</strong> and <strong>SQL Server</strong> — this is our contribution to modern education management.</p>
                <p class="about-thank">Thank You. 🙏</p>
            </div>
        </div>

        <div class="about-photo-col reveal">
            <div class="about-photo-row">
                <div class="about-photo-card">
                    <div class="about-photo-placeholder">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <div class="about-photo-info">
                        <div class="about-photo-name">Pavan Salunke</div>
                        <div class="about-photo-role">Founder &amp; Developer</div>
                    </div>
                </div>
                <div class="about-photo-card">
                    <div class="about-photo-placeholder">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <div class="about-photo-info">
                        <div class="about-photo-name">Chandrakant Bidve</div>
                        <div class="about-photo-role">Co-Founder &amp; Developer</div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ══════════════ FEATURES ══════════════ -->
    <section id="features">
        <div class="section-header reveal" style="text-align:center;">
            <span class="section-tag"><i class="fas fa-bolt"></i> Features</span>
            <h2 class="section-title">Why Choose SMS?</h2>
            <p class="section-sub" style="margin:0 auto;">Everything you need to manage your institution efficiently</p>
        </div>

        <div class="features-grid-new">
            <div class="feature-card-new reveal">
                <div class="feat-photo">
                    <img src="https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=600&q=80" alt="Student Management" />
                </div>
                <div class="feat-body">
                    <div class="feat-title-new">Student Management</div>
                    <div class="feat-desc-new">Complete student records with admission details, personal information, and comprehensive academic profiles.</div>
                </div>
            </div>
            <div class="feature-card-new reveal">
                <div class="feat-photo">
                    <img src="https://images.unsplash.com/photo-1606761568499-6d2451b23c66?w=600&q=80" alt="Attendance Tracking" />
                </div>
                <div class="feat-body">
                    <div class="feat-title-new">Attendance Tracking</div>
                    <div class="feat-desc-new">Automated daily attendance management with real-time updates and detailed subject-wise reports.</div>
                </div>
            </div>
            <div class="feature-card-new reveal">
                <div class="feat-photo">
                    <img src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=600&q=80" alt="Digital Marksheets" />
                </div>
                <div class="feat-body">
                    <div class="feat-title-new">Digital Marksheets</div>
                    <div class="feat-desc-new">Generate and manage digital marksheets with comprehensive grading and performance analytics.</div>
                </div>
            </div>
            <div class="feature-card-new reveal">
                <div class="feat-photo">
                    <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=600&q=80" alt="Teacher Management" />
                </div>
                <div class="feat-body">
                    <div class="feat-title-new">Teacher Management</div>
                    <div class="feat-desc-new">Manage faculty records, assign subjects, and allow teachers to update academic data easily.</div>
                </div>
            </div>
            <div class="feature-card-new reveal">
                <div class="feat-photo">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&q=80" alt="Search and Filter" />
                </div>
                <div class="feat-body">
                    <div class="feat-title-new">Search &amp; Filter</div>
                    <div class="feat-desc-new">Find any student instantly by name, ID, or course with real-time search and smart filters.</div>
                </div>
            </div>
            <div class="feature-card-new reveal">
                <div class="feat-photo">
                    <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=600&q=80" alt="Enterprise Security" />
                </div>
                <div class="feat-body">
                    <div class="feat-title-new">Enterprise Security</div>
                    <div class="feat-desc-new">Role-based authentication ensuring only authorized users access relevant data and features.</div>
                </div>
            </div>
        </div>

        <!-- Modules sub-section -->
        <div class="section-header reveal" style="text-align:center; margin-top:80px; margin-bottom:40px;">
            <span class="section-tag"><i class="fas fa-cubes"></i> System Modules</span>
            <h2 class="section-title">8 Core Modules</h2>
            <p class="section-sub" style="max-width:500px;margin:0 auto;">Each module handles a specific domain of academic administration.</p>
        </div>

        <div class="modules-grid">
            <div class="module-card reveal">
                <div class="module-num">01</div>
                <div class="module-icon"><i class="fas fa-key"></i></div>
                <div class="module-title">User Authentication</div>
                <div class="module-desc">Registration, login, logout for Admin, Teacher, and Student roles.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">02</div>
                <div class="module-icon"><i class="fas fa-user-cog"></i></div>
                <div class="module-title">Admin Management</div>
                <div class="module-desc">Full control — add, update, delete student and teacher records.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">03</div>
                <div class="module-icon"><i class="fas fa-user-graduate"></i></div>
                <div class="module-title">Student Management</div>
                <div class="module-desc">Store and manage student details including course, email, and age.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">04</div>
                <div class="module-icon"><i class="fas fa-chalkboard-teacher"></i></div>
                <div class="module-title">Teacher Management</div>
                <div class="module-desc">Manage faculty info and allow teachers to update academic data.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">05</div>
                <div class="module-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="module-title">Attendance Management</div>
                <div class="module-desc">Teachers mark and update student attendance by course and date.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">06</div>
                <div class="module-icon"><i class="fas fa-award"></i></div>
                <div class="module-title">Marks &amp; Results</div>
                <div class="module-desc">Add and update subject marks; auto-calculate totals and grades.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">07</div>
                <div class="module-icon"><i class="fas fa-search"></i></div>
                <div class="module-title">Search &amp; Filter</div>
                <div class="module-desc">Find students instantly by name, course, or ID with live search.</div>
            </div>
            <div class="module-card reveal">
                <div class="module-num">08</div>
                <div class="module-icon"><i class="fas fa-tachometer-alt"></i></div>
                <div class="module-title">Dashboard</div>
                <div class="module-desc">Admin overview of all students, teachers, and system activity.</div>
            </div>
        </div>
    </section>


    <!-- ══════════════ CONTACT ══════════════ -->
    <section id="contact">
        <!-- ✅ Contact header + grid same level — no extra wrapper -->
        <div class="contact-inner">
            <div class="contact-left reveal">
                <span class="section-tag" style="margin-bottom:14px;display:inline-block;"><i class="fas fa-envelope"></i> Contact</span>
                <div class="about-who-header">
                    <h3><i class="fas fa-envelope"></i> Get In Touch</h3>
                </div>
                <p class="section-sub" style="margin-bottom:28px;">Have questions about the SMS project? Reach out to the team.</p>

                <div class="contact-info">
                    <div class="contact-info-item">
                        <div class="ci-icon"><i class="fas fa-university"></i></div>
                        <div>
                            <div class="ci-label">Institution</div>
                            <div class="ci-val">School of IT, Indira University</div>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="ci-icon"><i class="fas fa-map-marker-alt"></i></div>
                        <div>
                            <div class="ci-label">Location</div>
                            <div class="ci-val">Pune, Maharashtra, India</div>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="ci-icon"><i class="fas fa-graduation-cap"></i></div>
                        <div>
                            <div class="ci-label">Programme</div>
                            <div class="ci-val">FY MCA · 2025–2026</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form-card reveal">
                <h3>Send a Message</h3>
                <p>Fill out the form and we'll get back to you soon.</p>
                <div class="cf-row">
                    <div class="cf-group">
                        <label>First Name</label>
                        <input type="text" placeholder="Your first name" />
                    </div>
                    <div class="cf-group">
                        <label>Last Name</label>
                        <input type="text" placeholder="Your last name" />
                    </div>
                </div>
                <div class="cf-group">
                    <label>Email Address</label>
                    <input type="email" placeholder="you@example.com" />
                </div>
                <div class="cf-group">
                    <label>Role</label>
                    <select>
                        <option value="">Select your role</option>
                        <option>Student</option>
                        <option>Teacher</option>
                        <option>Administrator</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="cf-group">
                    <label>Message</label>
                    <textarea placeholder="Write your message here…"></textarea>
                </div>
                <button class="btn-submit" id="contact-submit-btn"><i class="fas fa-paper-plane"></i> Send Message</button>
            </div>
        </div>
    </section>


