@page
@model StudentManagementSystem.Pages.Teacher.ProfileModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile — SMS Teacher</title>
    <link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Cabinet+Grotesk:wght@300;400;500;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root{--ink:#0d0f14;--ink2:#1c2030;--surface:#f5f4f0;--white:#fff;--accent:#0d9488;--accent2:#14b8a6;--muted:#64748b;--border:rgba(13,15,20,0.1);--grad:linear-gradient(135deg,#0d9488,#14b8a6);--font-display:'Clash Display',sans-serif;--font-body:'Cabinet Grotesk',sans-serif;--font-mono:'DM Mono',monospace;}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:var(--font-body);background:var(--surface);color:var(--ink);}
        .sidebar{position:fixed;left:0;top:0;bottom:0;width:240px;background:var(--ink2);display:flex;flex-direction:column;padding:28px 0;z-index:100;}
        .sb-logo{display:flex;align-items:center;gap:10px;padding:0 24px 28px;border-bottom:1px solid rgba(255,255,255,0.08);}
        .sb-logo-icon{width:36px;height:36px;border-radius:10px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:16px;}
        .sb-logo-text{font-family:var(--font-display);font-size:1.2rem;font-weight:700;color:#fff;} .sb-logo-text span{color:var(--accent2);}
        .sb-role-badge{margin:16px 24px 0;background:rgba(13,148,136,0.2);border:1px solid rgba(13,148,136,0.3);border-radius:8px;padding:6px 12px;font-size:0.75rem;font-weight:600;color:var(--accent2);font-family:var(--font-mono);text-align:center;}
        .sb-nav{margin-top:28px;flex:1;} .sb-label{padding:0 24px 8px;font-size:0.65rem;font-weight:600;color:rgba(255,255,255,0.25);text-transform:uppercase;letter-spacing:1.5px;}
        .sb-link{display:flex;align-items:center;gap:12px;padding:11px 24px;color:rgba(255,255,255,0.55);text-decoration:none;font-size:0.9rem;font-weight:500;transition:all 0.2s;border-left:3px solid transparent;}
        .sb-link:hover,.sb-link.active{color:#fff;background:rgba(255,255,255,0.06);border-left-color:var(--accent2);} .sb-link i{width:18px;text-align:center;}
        .sb-bottom{padding:20px 24px;border-top:1px solid rgba(255,255,255,0.08);}
        .sb-user{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
        .sb-avatar{width:36px;height:36px;border-radius:50%;background:var(--grad);display:grid;place-items:center;color:#fff;font-family:var(--font-display);font-size:0.9rem;font-weight:700;}
        .sb-user-name{font-size:0.85rem;font-weight:600;color:#fff;} .sb-user-role{font-size:0.72rem;color:rgba(255,255,255,0.4);}
        .btn-logout{width:100%;padding:9px;border:1px solid rgba(255,255,255,0.12);border-radius:8px;background:transparent;color:rgba(255,255,255,0.5);font-family:var(--font-body);font-size:0.85rem;font-weight:600;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:8px;}
        .btn-logout:hover{background:rgba(244,63,94,0.15);color:#f43f5e;border-color:rgba(244,63,94,0.3);}
        .main{margin-left:240px;padding:36px 40px;min-height:100vh;}
        .page-header{margin-bottom:32px;} .page-header h1{font-family:var(--font-display);font-size:1.8rem;font-weight:700;} .page-header p{color:var(--muted);margin-top:4px;}
        .profile-top{background:var(--ink2);border-radius:20px;padding:36px;display:flex;align-items:center;gap:28px;margin-bottom:28px;position:relative;overflow:hidden;}
        .profile-top::before{content:'';position:absolute;right:-60px;top:-60px;width:240px;height:240px;border-radius:50%;background:var(--grad);opacity:0.1;}
        .big-avatar{width:80px;height:80px;border-radius:50%;background:var(--grad);display:grid;place-items:center;color:#fff;font-family:var(--font-display);font-size:1.8rem;font-weight:700;flex-shrink:0;}
        .profile-name{font-family:var(--font-display);font-size:1.5rem;font-weight:700;color:#fff;}
        .profile-sub{color:rgba(255,255,255,0.5);font-size:0.9rem;margin-top:4px;}
        .profile-tags{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;}
        .profile-tag{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:100px;padding:4px 12px;font-size:0.75rem;font-weight:600;color:rgba(255,255,255,0.7);font-family:var(--font-mono);}
        .profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
        .card{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:28px;}
        .card-title{font-family:var(--font-display);font-size:1.1rem;font-weight:600;margin-bottom:20px;}
        .info-item{display:flex;gap:14px;align-items:flex-start;margin-bottom:18px;}
        .info-item:last-child{margin-bottom:0;}
        .info-icon{width:38px;height:38px;border-radius:10px;background:#ccfbf1;color:#0d9488;display:grid;place-items:center;font-size:0.9rem;flex-shrink:0;}
        .info-label{font-size:0.78rem;color:var(--muted);margin-bottom:2px;}
        .info-val{font-weight:600;font-size:0.95rem;}
        .form-group{margin-bottom:16px;} .form-group label{display:block;font-size:0.85rem;font-weight:600;margin-bottom:7px;}
        .form-group input{width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:var(--font-body);font-size:0.9rem;background:var(--surface);outline:none;transition:border 0.2s;}
        .form-group input:focus{border-color:var(--accent);background:var(--white);}
        .btn-save{padding:12px 28px;background:var(--grad);border:none;border-radius:10px;color:#fff;font-family:var(--font-body);font-size:0.95rem;font-weight:700;cursor:pointer;margin-top:8px;}
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sb-logo"><div class="sb-logo-icon"><i class="fas fa-graduation-cap"></i></div><div class="sb-logo-text">SM<span>S</span></div></div>
        <div class="sb-role-badge"><i class="fas fa-chalkboard-teacher"></i> &nbsp;TEACHER</div>
        <nav class="sb-nav">
            <div class="sb-label">Menu</div>
            <a href="/Teacher/Dashboard" class="sb-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a href="/Teacher/Students" class="sb-link"><i class="fas fa-user-graduate"></i> My Students</a>
            <a href="/Teacher/Attendance" class="sb-link"><i class="fas fa-calendar-check"></i> Attendance</a>
            <a href="/Teacher/Marks" class="sb-link"><i class="fas fa-chart-line"></i> Marks</a>
            <a href="/Teacher/Profile" class="sb-link active"><i class="fas fa-user"></i> My Profile</a>
        </nav>
        <div class="sb-bottom">
            <div class="sb-user"><div class="sb-avatar" id="sb-avatar">TC</div><div><div class="sb-user-name" id="sb-username">Teacher</div><div class="sb-user-role">Faculty</div></div></div>
            <button class="btn-logout" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </div>
    </aside>
    <main class="main">
        <div class="page-header"><h1>My Profile</h1><p>Your personal and professional information</p></div>
        <div class="profile-top">
            <div class="big-avatar" id="big-avatar">TC</div>
            <div>
                <div class="profile-name" id="profile-name">Teacher</div>
                <div class="profile-sub">Faculty · School of IT, Indira University</div>
                <div class="profile-tags"><span class="profile-tag">2025–2026</span><span class="profile-tag">FY MSC-CA</span><span class="profile-tag">Active</span></div>
            </div>
        </div>
        <div class="profile-grid">
            <div class="card">
                <div class="card-title">Personal Information</div>
                <div class="info-item"><div class="info-icon"><i class="fas fa-user"></i></div><div><div class="info-label">Full Name</div><div class="info-val">Prof. Ramesh Kumar</div></div></div>
                <div class="info-item"><div class="info-icon"><i class="fas fa-id-badge"></i></div><div><div class="info-label">Teacher ID</div><div class="info-val">T01</div></div></div>
                <div class="info-item"><div class="info-icon"><i class="fas fa-envelope"></i></div><div><div class="info-label">Email</div><div class="info-val">ramesh@sms.edu</div></div></div>
                <div class="info-item"><div class="info-icon"><i class="fas fa-phone"></i></div><div><div class="info-label">Phone</div><div class="info-val">9876543210</div></div></div>
                <div class="info-item"><div class="info-icon"><i class="fas fa-book"></i></div><div><div class="info-label">Subject</div><div class="info-val">Data Structures</div></div></div>
                <div class="info-item"><div class="info-icon"><i class="fas fa-university"></i></div><div><div class="info-label">Department</div><div class="info-val">School of IT</div></div></div>
            </div>
            <div class="card">
                <div class="card-title">Change Password</div>
                <div class="form-group"><label>Current Password</label><input type="password" placeholder="Current password" /></div>
                <div class="form-group"><label>New Password</label><input type="password" placeholder="New password" /></div>
                <div class="form-group"><label>Confirm Password</label><input type="password" placeholder="Confirm new password" /></div>
                <button class="btn-save" onclick="savePwd()"><i class="fas fa-save"></i> Update Password</button>
            </div>
        </div>
    </main>
    <script>
        const role = sessionStorage.getItem('sms_role'); const user = sessionStorage.getItem('sms_user');
        if (!role || !user) window.location.href = '/';
        if (user) {
            document.getElementById('sb-username').textContent = user;
            const init = user.substring(0,2).toUpperCase();
            document.getElementById('sb-avatar').textContent = init;
            document.getElementById('big-avatar').textContent = init;
            document.getElementById('profile-name').textContent = 'Prof. ' + user.charAt(0).toUpperCase() + user.slice(1);
        }
        function logout() { sessionStorage.clear(); window.location.href = '/'; }
        function savePwd() { alert('Password updated successfully!'); }
    </script>
</body>
</html>
