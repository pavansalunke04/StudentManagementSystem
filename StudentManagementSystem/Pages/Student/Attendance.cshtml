@page
@model StudentManagementSystem.Pages.Student.AttendanceModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Attendance — SMS Student</title>
    <link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Cabinet+Grotesk:wght@300;400;500;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root{--ink:#0d0f14;--ink2:#1c2030;--surface:#f5f4f0;--white:#fff;--accent:#7c3aed;--accent2:#a78bfa;--muted:#64748b;--border:rgba(13,15,20,0.1);--grad:linear-gradient(135deg,#7c3aed,#a78bfa);--font-display:'Clash Display',sans-serif;--font-body:'Cabinet Grotesk',sans-serif;--font-mono:'DM Mono',monospace;}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:var(--font-body);background:var(--surface);color:var(--ink);}
        .sidebar{position:fixed;left:0;top:0;bottom:0;width:240px;background:var(--ink2);display:flex;flex-direction:column;padding:28px 0;z-index:100;}
        .sb-logo{display:flex;align-items:center;gap:10px;padding:0 24px 28px;border-bottom:1px solid rgba(255,255,255,0.08);}
        .sb-logo-icon{width:36px;height:36px;border-radius:10px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:16px;}
        .sb-logo-text{font-family:var(--font-display);font-size:1.2rem;font-weight:700;color:#fff;} .sb-logo-text span{color:var(--accent2);}
        .sb-role-badge{margin:16px 24px 0;background:rgba(124,58,237,0.2);border:1px solid rgba(124,58,237,0.3);border-radius:8px;padding:6px 12px;font-size:0.75rem;font-weight:600;color:var(--accent2);font-family:var(--font-mono);text-align:center;}
        .sb-nav{margin-top:28px;flex:1;} .sb-label{padding:0 24px 8px;font-size:0.65rem;font-weight:600;color:rgba(255,255,255,0.25);text-transform:uppercase;letter-spacing:1.5px;}
        .sb-link{display:flex;align-items:center;gap:12px;padding:11px 24px;color:rgba(255,255,255,0.55);text-decoration:none;font-size:0.9rem;font-weight:500;transition:all 0.2s;border-left:3px solid transparent;}
        .sb-link:hover,.sb-link.active{color:#fff;background:rgba(255,255,255,0.06);border-left-color:var(--accent2);} .sb-link i{width:18px;text-align:center;}
        .sb-bottom{padding:20px 24px;border-top:1px solid rgba(255,255,255,0.08);}
        .sb-user{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
        .sb-avatar{width:36px;height:36px;border-radius:50%;background:var(--grad);display:grid;place-items:center;color:#fff;font-family:var(--font-display);font-size:0.9rem;font-weight:700;}
        .sb-user-name{font-size:0.85rem;font-weight:600;color:#fff;} .sb-user-role{font-size:0.72rem;color:rgba(255,255,255,0.4);}
        .btn-logout{width:100%;padding:9px;border:1px solid rgba(255,255,255,0.12);border-radius:8px;background:transparent;color:rgba(255,255,255,0.5);font-family:var(--font-body);font-size:0.85rem;font-weight:600;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:8px;}
        .btn-logout:hover{background:rgba(244,63,94,0.15);color:#f43f5e;border-color:rgba(244,63,94,0.3);}
        .main{margin-left:240px;padding:36px 40px;min-height:100vh;}
        .page-header{margin-bottom:32px;} .page-header h1{font-family:var(--font-display);font-size:1.8rem;font-weight:700;} .page-header p{color:var(--muted);margin-top:4px;}
        .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:28px;}
        .stat-card{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:24px;text-align:center;}
        .stat-val{font-family:var(--font-display);font-size:2rem;font-weight:700;}
        .stat-lbl{font-size:0.8rem;color:var(--muted);margin-top:4px;}
        .stat-card.green .stat-val{color:#16a34a;} .stat-card.red .stat-val{color:#dc2626;} .stat-card.purple .stat-val{color:#7c3aed;}
        .card{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:28px;}
        .card-title{font-family:var(--font-display);font-size:1.1rem;font-weight:600;margin-bottom:20px;}
        table{width:100%;border-collapse:collapse;}
        th{font-size:0.72rem;color:var(--muted);text-align:left;padding:10px 14px;text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border);}
        td{font-size:0.875rem;padding:13px 14px;border-bottom:1px solid var(--border);}
        tr:last-child td{border-bottom:none;}
        .pill{display:inline-block;padding:3px 10px;border-radius:100px;font-size:0.72rem;font-weight:600;}
        .pill.present{background:#dcfce7;color:#16a34a;} .pill.absent{background:#fee2e2;color:#dc2626;}
        .empty-msg{text-align:center;color:var(--muted);padding:32px;font-size:0.95rem;}
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sb-logo"><div class="sb-logo-icon"><i class="fas fa-graduation-cap"></i></div><div class="sb-logo-text">SM<span>S</span></div></div>
        <div class="sb-role-badge"><i class="fas fa-user-graduate"></i> &nbsp;STUDENT</div>
        <nav class="sb-nav">
            <div class="sb-label">Menu</div>
            <a href="/Student/Dashboard" class="sb-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a href="/Student/Attendance" class="sb-link active"><i class="fas fa-calendar-check"></i> My Attendance</a>
            <a href="/Student/Marks" class="sb-link"><i class="fas fa-chart-line"></i> My Marks</a>
            <a href="/Student/Profile" class="sb-link"><i class="fas fa-user"></i> My Profile</a>
        </nav>
        <div class="sb-bottom">
            <div class="sb-user"><div class="sb-avatar" id="sb-avatar">ST</div><div><div class="sb-user-name" id="sb-username">Student</div><div class="sb-user-role">FY MSC-CA</div></div></div>
            <button class="btn-logout" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </div>
    </aside>
    <main class="main">
        <div class="page-header"><h1>My Attendance</h1><p>Your attendance record across all subjects</p></div>

        <!-- ✅ REAL DATA — database se aa raha hai -->
        <div class="stats-grid">
            <div class="stat-card green">
                <div class="stat-val">@Model.TotalPresent</div>
                <div class="stat-lbl">Classes Present</div>
            </div>
            <div class="stat-card red">
                <div class="stat-val">@Model.TotalAbsent</div>
                <div class="stat-lbl">Classes Absent</div>
            </div>
            <div class="stat-card purple">
                <div class="stat-val">@Model.OverallRate</div>
                <div class="stat-lbl">Overall Rate</div>
            </div>
        </div>

        <!-- ✅ REAL RECORDS — database se -->
        <div class="card">
            <div class="card-title">Recent Attendance Records</div>
            @if (Model.RecentRecords.Count == 0)
            {
                <div class="empty-msg">
                    <i class="fas fa-calendar-times" style="font-size:2rem;margin-bottom:10px;display:block;"></i>
                    Koi attendance record nahi mila abhi tak.
                </div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Course</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rec in Model.RecentRecords)
                        {
                            <tr>
                                <td>@rec.Date.ToString("dd MMM yyyy")</td>
                                <td>@(rec.Course ?? "—")</td>
                                <td>
                                    <span class="pill @(rec.Status == "Present" ? "present" : "absent")">
                                        @rec.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </main>
    <script>
        const role = sessionStorage.getItem('sms_role');
        const user = sessionStorage.getItem('sms_user');
        if (!role || !user) window.location.href = '/';
        if (user) {
            document.getElementById('sb-username').textContent = user;
            document.getElementById('sb-avatar').textContent = user.substring(0,2).toUpperCase();
        }
        function logout() { sessionStorage.clear(); window.location.href = '/'; }
    </script>
</body>
</html>
